{
  "name": "remark-shiki-highlight-api",
  "version": "0.5.0",
  "description": "Remark plugin for shiki-highlight-api - replaces traditional Shiki code blocks with CSS Custom Highlight API",
  "keywords": [
    "remark",
    "remark-plugin",
    "shiki",
    "syntax-highlighting",
    "highlight-api",
    "markdown",
    "mdx"
  ],
  "author": "Steve Hill <steve@stevehill.xyz>",
  "license": "MIT",
  "homepage": "https://github.com/shiki-highlights/remark-shiki-highlight-api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiki-highlights/remark-shiki-highlight-api.git"
  },
  "bugs": {
    "url": "https://github.com/shiki-highlights/remark-shiki-highlight-api/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "playwright:install": "playwright install chromium",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build && npm test && npm run test:package",
    "test:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "shiki": "^4.5.0",
    "shiki-highlight-api": "^2.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "peerDependencies": {
    "unified": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
